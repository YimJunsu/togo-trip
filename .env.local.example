# Supabase 연동용. 실제 값은 .env.local에 넣고 커밋하지 않는다.
# 값은 Supabase 대시보드 > Project Settings > API 에서 복사한다.

# mock 유지: 이 줄이 없거나 'supabase'가 아니면 모든 데이터는 mock으로 흐른다.
# 'supabase'로 두면 회원·여행방·지출·정산이 실서버로 흐른다.
# (place·궁합·여행지는 스위치와 무관하게 아직 mock)
NEXT_PUBLIC_DATA_SOURCE=mock

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# publishable 키(sb_publishable_... 또는 레거시 anon JWT). 클라이언트 노출용.
# 시크릿 키(sb_secret_...)는 절대 여기·클라이언트에 넣지 않는다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# 배포 도메인 덮어쓰기(선택). 기본값은 https://togo-trip.com 이고, 보통 건드릴 일이 없다.
# 로컬에서 canonical/og를 localhost로 보고 싶을 때만 잠깐 켠다.
# 운영에 이 값이 들어가도 로컬 주소면 lib/seo/site.ts가 무시한다.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 공공데이터 관광정보 적재 (feat/tour-api-ingest) ──────────────────────────
# 공공데이터포털에서 발급받은 TourAPI 인증키(Decoding 키를 쓴다).
# NEXT_PUBLIC_을 붙이지 않는다 — 붙이면 클라이언트 번들에 그대로 실린다.
TOUR_API_KEY=YOUR-TOUR-API-KEY

# Supabase 시크릿 키(sb_secret_... 또는 레거시 service_role JWT).
# RLS를 우회하는 키다. lib/supabase/admin.ts 밖에서 읽지 않는다.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# cron 엔드포인트 검증용. 아무 긴 난수 문자열이면 된다.
# 로컬 확인: openssl rand -hex 32
CRON_SECRET=YOUR-CRON-SECRET
